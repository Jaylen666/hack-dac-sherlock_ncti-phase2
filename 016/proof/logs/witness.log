--- src/hmac/rtl/hmac_core.sv:181,206 (the case statement: reset arm vs zeroize arm) ---
  always_ff @(posedge clk or negedge reset_n) begin : reg_update
    unique case (1'b1)
      !reset_n: begin
        // Async power-on/core reset: force every status/control reg to idle
        digest_valid_reg <= 1'b0;
        hmac_ctrl_reg    <= CTRL_IDLE;
        hmac_ctrl_last   <= CTRL_IDLE;
      end

      zeroize: begin
        // Security zeroize request: collapse control FSM back to idle.
        // digest_valid_reg is refreshed by the normal update path below
        // on a later cycle, so it does not need to be touched here.
        hmac_ctrl_reg  <= CTRL_IDLE;
        hmac_ctrl_last <= CTRL_IDLE;
      end

      default: begin
        // Normal operating path: latch previous ctrl state, apply pending updates
        hmac_ctrl_last <= hmac_ctrl_reg;

        if (digest_valid_we)
          digest_valid_reg <= digest_valid_new;

        if (hmac_ctrl_we)
          hmac_ctrl_reg <= hmac_ctrl_new;

