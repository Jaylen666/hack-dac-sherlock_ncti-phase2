--- src/hmac/rtl/hmac_core.sv:326,351 (the FSM idle arm the comment relies on) ---
  always_comb begin : hmac_ctrl_fsm
    ready_flag       = 1'b0;
    digest_valid_new = 1'b0;
    digest_valid_we  = 1'b0;
    hmac_ctrl_new    = CTRL_IDLE;
    hmac_ctrl_we     = 1'b0;

    set_entropy = 1'b0;

    unique case (hmac_ctrl_reg)
      CTRL_IDLE: begin
        ready_flag = 1'b1;

        if (init_cmd) begin
          digest_valid_new = 1'b0;
          hmac_ctrl_new    = CTRL_IPAD;
          hmac_ctrl_we     = 1'b1;
        end

        if (next_cmd) begin
          digest_valid_new = 1'b0;
          digest_valid_we  = 1'b1;
          hmac_ctrl_new    = CTRL_OPAD;
          hmac_ctrl_we     = 1'b1;
        end
      end

