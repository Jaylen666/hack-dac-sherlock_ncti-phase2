--- src/pcrvault/rtl/pv_gen_hash.sv:199,220 (the always_ff and its three arms) ---
always_ff @(posedge clk or negedge rst_b) begin : api_regs
    if (~rst_b) begin
      gen_hash_fsm_ps <= GEN_HASH_IDLE;
      block_offset_i  <= '0;
      nonce_offset_i  <= '0;
      read_entry      <= '0;
      read_offset     <= '0;
    end
    else if (zeroize) begin
      gen_hash_fsm_ps <= GEN_HASH_IDLE;
      block_offset_i  <= '0;
      nonce_offset_i  <= '0;
    end
    
    else begin
      gen_hash_fsm_ps <= gen_hash_fsm_ns;
      block_offset_i <= block_offset_nxt;
      nonce_offset_i <= nonce_offset_nxt;
      read_entry <= read_entry_nxt;
      read_offset <= read_offset_nxt;
    end
  end

--- src/keyvault/rtl/kv_fsm.sv:158,172 (the sibling, whose arms match) ---
always_ff @(posedge clk or negedge rst_b) begin
    if (!rst_b) begin
        kv_fsm_ps <= KV_IDLE;
        offset <= '0;
    end
    else if (zeroize) begin
        kv_fsm_ps <= KV_IDLE;
        offset <= '0;
    end
    else begin
        kv_fsm_ps <= kv_fsm_ns;
        offset <= offset_rst ? '0 :
                  offset_en ? offset_nxt : offset;
    end
end

